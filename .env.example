# SkillGap AI Environment Configuration

# Server
PORT=5000
NODE_ENV=development
API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# Database (Default uses SQLite dev.db inside database/prisma/dev.db)
# For production PostgreSQL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/skillgap_ai?schema=public"
DATABASE_URL="file:../../database/prisma/dev.db"

# JWT Auth Secret
JWT_SECRET="super-secret-development-key-skillgap-ai-2026-production-ready"
JWT_EXPIRES_IN="7d"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
